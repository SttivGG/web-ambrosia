generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MoneyAccountType {
  CASH
  BANK
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum FinanceMovementKind {
  ADDITIONAL_INCOME
  EXPENSE
  PURCHASE_PAYMENT
  SALE_INCOME
  SALE_REFUND
}

enum FinanceDirection {
  CREDIT
  DEBIT
}

enum SaleStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLATION_PENDING
  CANCELLED
}

enum SaleOperationKind {
  CONFIRM
  CANCEL
}

enum SaleOperationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model MoneyAccount {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique @db.VarChar(40)
  name        String            @db.VarChar(120)
  type        MoneyAccountType
  description String?           @db.VarChar(500)
  active      Boolean           @default(true)
  currency    String            @default("COP") @db.VarChar(3)
  version     Int               @default(1)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  archivedAt  DateTime?         @db.Timestamptz(3)
  movements   FinanceMovement[]
  payments    PurchasePayment[]
  sales       Sale[]

  @@index([active, name, id])
}

model FinanceMovement {
  id              String              @id @default(uuid()) @db.Uuid
  operationId     String              @unique @db.Uuid
  accountId       String              @db.Uuid
  account         MoneyAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  kind            FinanceMovementKind
  direction       FinanceDirection
  amount          Decimal             @db.Decimal(24, 2)
  currency        String              @default("COP") @db.VarChar(3)
  status          String              @default("CONFIRMED") @db.VarChar(12)
  paymentMethod   PaymentMethod
  occurredAt      DateTime            @db.Timestamptz(3)
  reference       String?             @db.VarChar(120)
  description     String              @db.VarChar(500)
  actorId         String              @db.Uuid
  saleId          String?             @db.Uuid
  sale            Sale?               @relation(fields: [saleId], references: [id], onDelete: Restrict)
  reversesId      String?             @unique @db.Uuid
  reverses        FinanceMovement?    @relation("finance_reversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy      FinanceMovement?    @relation("finance_reversal")
  purchasePayment PurchasePayment?
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)

  @@index([accountId, occurredAt, id])
  @@index([kind, occurredAt, id])
  @@index([saleId])
}

model PurchasePayment {
  id                 String          @id @default(uuid()) @db.Uuid
  operationId        String          @unique @db.Uuid
  purchaseId         String          @db.Uuid
  accountId          String          @db.Uuid
  account            MoneyAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  movementId         String          @unique @db.Uuid
  movement           FinanceMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  amount             Decimal         @db.Decimal(24, 2)
  currency           String          @default("COP") @db.VarChar(3)
  paymentMethod      PaymentMethod
  occurredAt         DateTime        @db.Timestamptz(3)
  reference          String?         @db.VarChar(120)
  description        String?         @db.VarChar(500)
  actorId            String          @db.Uuid
  purchaseSnapshot   Json
  discrepancy        Boolean         @default(false)
  discrepancyReason  String?         @db.VarChar(500)
  checkedAt          DateTime?       @db.Timestamptz(3)
  regularizedAt      DateTime?       @db.Timestamptz(3)
  regularizedBy      String?         @db.Uuid
  regularizationNote String?         @db.VarChar(500)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)

  @@index([purchaseId, occurredAt, id])
  @@index([discrepancy, occurredAt, id])
}

model Sale {
  id                 String            @id @default(uuid()) @db.Uuid
  accountId          String            @db.Uuid
  account            MoneyAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  status             SaleStatus        @default(PENDING)
  subtotal           Decimal           @db.Decimal(24, 2)
  total              Decimal           @db.Decimal(24, 2)
  costOfGoodsSold    Decimal?          @db.Decimal(48, 18)
  grossMargin        Decimal?          @db.Decimal(48, 18)
  grossMarginPercent Decimal?          @db.Decimal(24, 10)
  currency           String            @default("COP") @db.VarChar(3)
  paymentMethod      PaymentMethod
  occurredAt         DateTime          @db.Timestamptz(3)
  reference          String?           @db.VarChar(120)
  description        String?           @db.VarChar(500)
  actorId            String            @db.Uuid
  version            Int               @default(1)
  confirmedAt        DateTime?         @db.Timestamptz(3)
  cancelledAt        DateTime?         @db.Timestamptz(3)
  cancellationReason String?           @db.VarChar(500)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  lines              SaleLine[]
  operations         SaleOperation[]
  movements          FinanceMovement[]

  @@index([status, occurredAt, id])
  @@index([reference])
}

model SaleLine {
  id           String   @id @default(uuid()) @db.Uuid
  saleId       String   @db.Uuid
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  itemId       String   @db.Uuid
  sku          String   @db.VarChar(40)
  name         String   @db.VarChar(120)
  quantity     Int
  unitPrice    Decimal  @db.Decimal(24, 2)
  subtotal     Decimal  @db.Decimal(24, 2)
  unitCost     Decimal? @db.Decimal(48, 18)
  costSubtotal Decimal? @db.Decimal(48, 18)

  @@unique([saleId, itemId])
  @@index([itemId])
}

model SaleOperation {
  id                  String              @id @db.Uuid
  saleId              String              @db.Uuid
  sale                Sale                @relation(fields: [saleId], references: [id], onDelete: Restrict)
  kind                SaleOperationKind
  status              SaleOperationStatus @default(PENDING)
  payload             Json
  result              Json?
  error               String?             @db.VarChar(500)
  originalOperationId String?             @unique @db.Uuid
  original            SaleOperation?      @relation("sale_compensation", fields: [originalOperationId], references: [id], onDelete: Restrict)
  compensation        SaleOperation?      @relation("sale_compensation")
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)

  @@index([status, updatedAt, id])
  @@index([saleId, createdAt, id])
}

model ReportProcessedEvent {
  eventId        String   @id @db.Uuid
  subject        String   @db.VarChar(80)
  sourceService  String   @db.VarChar(80)
  sourceEntityId String   @db.Uuid
  operationId    String?  @db.Uuid
  occurredAt     DateTime @db.Timestamptz(3)
  processedAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([sourceEntityId])
  @@index([operationId])
  @@index([occurredAt])
  @@index([processedAt])
}

model ReportInventoryItem {
  sourceService       String   @db.VarChar(80)
  sourceEntityId      String   @id @db.Uuid
  sourceVersion       BigInt
  operationId         String?  @db.Uuid
  eventId             String   @unique @db.Uuid
  occurredAt          DateTime @db.Timestamptz(3)
  processedAt         DateTime @default(now()) @db.Timestamptz(3)
  itemId              String   @unique @db.Uuid
  itemNameSnapshot    String   @db.VarChar(120)
  itemType            String   @db.VarChar(32)
  unit                String   @db.VarChar(20)
  onHand              Decimal  @db.Decimal(24, 10)
  valuationStatus     String   @db.VarChar(16)
  weightedAverageCost Decimal? @db.Decimal(48, 18)
  inventoryValue      Decimal? @db.Decimal(48, 18)
  active              Boolean
  updatedAt           DateTime @db.Timestamptz(3)

  @@index([operationId])
  @@index([eventId])
  @@index([occurredAt])
  @@index([updatedAt])
  @@index([itemType, valuationStatus])
}

model ReportInventoryMovement {
  sourceService    String   @db.VarChar(80)
  sourceEntityId   String   @id @db.Uuid
  sourceVersion    BigInt
  operationId      String?  @db.Uuid
  eventId          String   @unique @db.Uuid
  occurredAt       DateTime @db.Timestamptz(3)
  processedAt      DateTime @default(now()) @db.Timestamptz(3)
  movementId       String   @unique @db.Uuid
  itemId           String   @db.Uuid
  itemNameSnapshot String   @db.VarChar(120)
  movementType     String   @db.VarChar(32)
  reference        String   @db.VarChar(120)
  quantityIn       Decimal  @db.Decimal(24, 10)
  quantityOut      Decimal  @db.Decimal(24, 10)
  balanceAfter     Decimal? @db.Decimal(24, 10)
  unitCost         Decimal? @db.Decimal(48, 18)
  totalCost        Decimal? @db.Decimal(48, 18)
  averageCostAfter Decimal? @db.Decimal(48, 18)

  @@index([itemId, occurredAt])
  @@index([operationId])
  @@index([eventId])
  @@index([occurredAt])
  @@index([movementType, occurredAt])
}

model ReportProductionBatch {
  sourceService           String    @db.VarChar(80)
  sourceEntityId          String    @id @db.Uuid
  sourceVersion           BigInt
  operationId             String?   @db.Uuid
  eventId                 String    @unique @db.Uuid
  occurredAt              DateTime  @db.Timestamptz(3)
  processedAt             DateTime  @default(now()) @db.Timestamptz(3)
  batchId                 String    @unique @db.Uuid
  batch                   String    @db.VarChar(80)
  productId               String    @db.Uuid
  productNameSnapshot     String?   @db.VarChar(120)
  status                  String    @db.VarChar(24)
  startedAt               DateTime? @db.Timestamptz(3)
  completedAt             DateTime? @db.Timestamptz(3)
  inputQuantity           Decimal   @db.Decimal(24, 10)
  outputQuantity          Decimal?  @db.Decimal(24, 10)
  yieldPercentage         Decimal?  @db.Decimal(24, 10)
  wasteQuantity           Decimal?  @db.Decimal(24, 10)
  accumulatedCost         Decimal?  @db.Decimal(48, 18)
  sellableCost            Decimal?  @db.Decimal(48, 18)
  packagingOutputQuantity Decimal?  @db.Decimal(24, 10)

  @@index([productId, occurredAt])
  @@index([operationId])
  @@index([eventId])
  @@index([occurredAt])
  @@index([status, occurredAt])
}

model ReportSaleMargin {
  sourceService       String   @db.VarChar(80)
  sourceEntityId      String   @id @db.Uuid
  sourceVersion       BigInt
  operationId         String?  @db.Uuid
  eventId             String   @unique @db.Uuid
  occurredAt          DateTime @db.Timestamptz(3)
  processedAt         DateTime @default(now()) @db.Timestamptz(3)
  saleId              String   @db.Uuid
  saleLineId          String   @unique @db.Uuid
  status              String   @db.VarChar(24)
  productId           String   @db.Uuid
  productNameSnapshot String   @db.VarChar(120)
  quantity            Decimal  @db.Decimal(24, 10)
  revenue             Decimal  @db.Decimal(48, 18)
  cogs                Decimal? @db.Decimal(48, 18)
  grossMargin         Decimal? @db.Decimal(48, 18)
  grossMarginPercent  Decimal? @db.Decimal(24, 10)

  @@index([saleId])
  @@index([productId, occurredAt])
  @@index([operationId])
  @@index([eventId])
  @@index([occurredAt])
  @@index([status, occurredAt])
}

// Fase 4: fórmulas, lotes y coordinación persistente propia.
generator client {
 provider = "prisma-client"
 output = "../src/generated/prisma"
 moduleFormat = "cjs"
}
datasource db {
 provider = "postgresql"
}

model Formula {
 id String @id @default(uuid()) @db.Uuid
 name String @db.VarChar(120)
 active Boolean @default(true)
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 revisions FormulaRevision[]
 @@index([active, name, id])
}
model FormulaRevision {
 id String @id @default(uuid()) @db.Uuid
 formulaId String @db.Uuid
 formula Formula @relation(fields: [formulaId], references: [id], onDelete: Restrict)
 version Int
 snapshot Json
 orders ProductionOrder[]
 @@unique([formulaId, version])
}
enum ProductionStatus {
 DRAFT
 IN_PROGRESS
 COMPLETED
 CANCELLED
}
enum ProductionOperationStatus {
 PENDING
 CONFIRMED
 REJECTED
}
enum ProductionOperationKind {
 CONSUME
 REVERSE
 YIELD
 PACKAGE
}
enum ProductionRecordStatus {
 PENDING
 CONFIRMED
 REJECTED
}
model ProductionOrder {
 id String @id @default(uuid()) @db.Uuid
 batch String @unique @db.VarChar(80)
 formulaRevisionId String @db.Uuid
 formulaRevision FormulaRevision @relation(fields: [formulaRevisionId], references: [id], onDelete: Restrict)
 quantity Decimal @db.Decimal(24,10)
 ingredients Json
 scheduledAt DateTime @db.Timestamptz(3)
 notes String? @db.VarChar(2000)
 status ProductionStatus @default(DRAFT)
 version Int @default(1)
 actorId String @db.Uuid
 startedAt DateTime? @db.Timestamptz(3)
 completedAt DateTime? @db.Timestamptz(3)
 cancelledAt DateTime? @db.Timestamptz(3)
 cancellationReason String? @db.VarChar(500)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 operations ProductionOperation[]
 yields ProductionYield[]
 packagingOperations PackagingOperation[]
 @@index([status, scheduledAt, id])
}
model ProductionOperation {
 id String @id @default(uuid()) @db.Uuid
 orderId String @db.Uuid
 order ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
 kind ProductionOperationKind
 status ProductionOperationStatus @default(PENDING)
 payload Json
 result Json?
 error String? @db.VarChar(500)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 yield ProductionYield?
 packaging PackagingOperation?
 @@index([status, createdAt, id])
 @@index([orderId, createdAt, id])
}

model ProductionYield {
 id String @id @default(uuid()) @db.Uuid
 orderId String @db.Uuid
 order ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
 operationId String @unique @db.Uuid
 operation ProductionOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
 productId String @db.Uuid
 plannedQuantity Decimal @db.Decimal(24,10)
 actualQuantity Decimal @db.Decimal(24,10)
 differenceQuantity Decimal @db.Decimal(24,10)
 yieldPercentage Decimal @db.Decimal(24,10)
 wasteQuantity Decimal @db.Decimal(24,10)
 wastePercentage Decimal @db.Decimal(24,10)
 baseUnit String @db.VarChar(20)
 occurredAt DateTime @db.Timestamptz(3)
 actorId String @db.Uuid
 notes String? @db.VarChar(2000)
 wasteReason String? @db.VarChar(500)
 status ProductionRecordStatus @default(PENDING)
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 packagingOperations PackagingOperation[]
 @@index([orderId, createdAt, id])
 @@index([status, occurredAt, id])
}

model PackagingOperation {
 id String @id @default(uuid()) @db.Uuid
 orderId String @db.Uuid
 order ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
 yieldId String @db.Uuid
 yield ProductionYield @relation(fields: [yieldId], references: [id], onDelete: Restrict)
 operationId String @unique @db.Uuid
 operation ProductionOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
 bulkProductId String @db.Uuid
 presentationProductId String @db.Uuid
 unitsPackaged Decimal @db.Decimal(24,10)
 productQuantityPerUnit Decimal @db.Decimal(24,10)
 productQuantityUsed Decimal @db.Decimal(24,10)
 baseUnit String @db.VarChar(20)
 materials Json
 occurredAt DateTime @db.Timestamptz(3)
 actorId String @db.Uuid
 notes String? @db.VarChar(2000)
 status ProductionRecordStatus @default(PENDING)
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 @@index([orderId, occurredAt, id])
 @@index([status, occurredAt, id])
 @@index([presentationProductId, occurredAt, id])
}

# Exclusivamente desarrollo local. Cambiar TODAS las claves fuera de este entorno.
NODE_ENV=development
ADMIN_WEB_PORT=3000
INVENTORY_SERVICE_PORT=3001
PRODUCTION_SERVICE_PORT=3002
FINANCE_REPORTING_SERVICE_PORT=3003
IDENTITY_SERVICE_PORT=3004
GATEWAY_PORT=8080
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=ambrosia_admin
POSTGRES_ADMIN_PASSWORD=local_admin_only_change_me
INVENTORY_DB_PASSWORD=local_inventory_only_change_me
PRODUCTION_DB_PASSWORD=local_production_only_change_me
FINANCE_DB_PASSWORD=local_finance_only_change_me
IDENTITY_DATABASE_NAME=ambrosia_identity
IDENTITY_DATABASE_USER=identity_user
IDENTITY_DATABASE_PASSWORD=local_identity_database_change_me
# Mantener las contraseñas anteriores y estas URLs sincronizadas (URL-encode si corresponde).
INVENTORY_DATABASE_URL=postgresql://inventory_user:local_inventory_only_change_me@127.0.0.1:5432/ambrosia_inventory
PRODUCTION_DATABASE_URL=postgresql://production_user:local_production_only_change_me@127.0.0.1:5432/ambrosia_production
FINANCE_REPORTING_DATABASE_URL=postgresql://finance_user:local_finance_only_change_me@127.0.0.1:5432/ambrosia_finance_reports
IDENTITY_DATABASE_URL=postgresql://identity_user:local_identity_database_change_me@127.0.0.1:5432/ambrosia_identity
NATS_URL=nats://127.0.0.1:4222
NATS_USER=ambrosia_local
NATS_PASSWORD=local_nats_only_change_me
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
LOG_LEVEL=log

# Identidad. Las claves y AUTH_CSRF_SECRET se generan en secrets/auth.local.env
# con `pnpm auth:keys:generate`; nunca se versionan ni se incluyen aquí.
JWT_ISSUER=http://localhost:8080/api/auth
JWT_AUDIENCE=ambrosia-services
JWT_ACCESS_TTL_SECONDS=900
JWT_KEY_ID=ambrosia-local-1
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_LOGIN_RATE_LIMIT=20
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
AUTH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_PATH=/api/auth

# Solo servidor Next; Compose utiliza su DNS privado.
IDENTITY_INTERNAL_URL=http://127.0.0.1:3004

# Fase 1C: verificador público, sin secretos de Identity
AUTH_JWKS_URL=http://127.0.0.1:3004/.well-known/jwks.json
AUTH_ALLOWED_ALGORITHM=RS256
AUTH_JWKS_TIMEOUT_MS=2000
AUTH_JWKS_CACHE_TTL_SECONDS=300
# AUTH_ISSUER / AUTH_AUDIENCE usan JWT_ISSUER / JWT_AUDIENCE si se omiten.
# AUTH_ALLOWED_ORIGINS usa CORS_ALLOWED_ORIGINS si se omite.
# Convenciones compatibles: ACCESS_COOKIE_NAME=ambrosia_access,
# CSRF_COOKIE_NAME=ambrosia_csrf, CSRF_HEADER_NAME=x-csrf-token.
